# Python cache
__pycache__
*.py[cod]
*$py.class
*.egg-info
*.egg-info/
*.sage.py
/dist/
/build/

# Test / coverage / type-check / lint caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Shared libraries
*.so

# Swap files
*.swp

# Input/output lattice bases
/input/
/output/

# Local eigen files
/eigen*

# Virtual environments
/venv/
.venv/

# Local conda/env activation shims
/activate
/python3

# Environment files (may hold secrets)
.env
.env.*

# cysignals creates this directory when Ctrl+C'ing during execution
cysignals_crash_logs/

# Benchmarks generate big logs
/logs/
/logs-flatter/
/benchmark/results/
/logs_other_*.csv
/benchmark/logs_other_*.csv
/debug.log

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Scratch (do not commit)
t.py

# Superpowers agent workspace (git-ignored by design)
.superpowers/
